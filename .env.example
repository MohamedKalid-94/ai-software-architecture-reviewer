# ---------------------------------------------------
# Application
# ---------------------------------------------------

APP_NAME=AI Software Architecture Reviewer
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------
# Logging
# ---------------------------------------------------

LOG_LEVEL=INFO
LOG_PATH=logs/application.log

# ---------------------------------------------------
# LLM
# ---------------------------------------------------

OPENAI_API_KEY=
GOOGLE_API_KEY=

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1

# ---------------------------------------------------
# Embeddings
# ---------------------------------------------------

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------
# LangSmith
# ---------------------------------------------------

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

LANGCHAIN_API_KEY=

LANGCHAIN_PROJECT=AI Software Architecture Reviewer